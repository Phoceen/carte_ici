# Configuration des clés API
# Copiez ce fichier vers .env et remplissez vos vraies clés

# Google Maps Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenRouteService API (pour isochrones)
ORS_API_KEY=your_openrouteservice_api_key_here

# TravelTime API (optionnel)
TRAVELTIME_APP_ID=your_traveltime_app_id_here
TRAVELTIME_API_KEY=your_traveltime_api_key_here